 "deploy_config": {
  "yaml": "# Single-stage Qwen3-TTS: the Talker decodes every frame with the stateful\n# streaming codec decoder and returns PCM itself (no Code2Wav stage).\n# reset_prefix_cache(reset_running_requests=True) returns False while requests\n# are running; wait for completion or abort them before resetting the cache.\npipeline: qwen3_tts_fused\nmodel_runner: v2\nasync_chunk: true\n\nstages:\n  - stage_id: 0\n    devices: \"0\"\n    max_num_seqs: 128\n    # Exact conditioned Talker inputs for preemption replay are allocated\n    # after KV profiling: 16 MiB per active request at 1.7B/max_model_len=4096\n    # (~2 GiB at 128 requests), in addition to codec state and output buffers.\n    # MRv2 fused CUDA also builds a ~0.6 GB projected text table before KV\n    # profiling. V1 and two-stage deployments do not allocate that table.\n    # Keep headroom when increasing gpu_memory_utilization or capacity.\n    gpu_memory_utilization: 0.5\n    trust_remote_code: true\n    enable_prefix_caching: false\n    # Model options that multi-stage deployments put on the connector: a\n    # single stage has no connector edge.\n    additional_config:\n      talker_stream_decode: true\n      # Opt in to first-frame delivery on its own queue for lower first-audio\n      # latency; leave disabled when prioritizing peak throughput.\n      talker_stream_first_audio: false\n      # Match the standard two-stage profile's voice-clone context boundary.\n      # A shorter context (e.g. 25) can change timbre continuity.\n      ref_code_context_frames: 72\n      code_predictor_kv_cache: true\n      code_predictor_fused_sampling: true\n      code_predictor_fused: true\n      # Serving-side runaway ceiling for requests without max_new_tokens:\n      # max(codec_budget_min_frames, codec_budget_frames_per_text_token *\n      # input text tokens) codec frames, capped by max_tokens below. Each\n      # key takes a number (all tasks) or a per-task mapping; a rate of 0\n      # disables the ceiling. Defaults:\n      # codec_budget_frames_per_text_token: {Base: 12, CustomVoice: 40, VoiceDesign: 40}\n      # codec_budget_min_frames: {Base: 192, CustomVoice: 400, VoiceDesign: 400}\n    attention_config:\n      flash_attn_max_num_splits_for_cuda_graph: 1\n    async_scheduling: true\n    max_num_batched_tokens: 512\n    max_model_len: 4096\n    compilation_config:\n      cudagraph_mode: FULL\n      cudagraph_capture_sizes: [1, 2, 4, 8, 16, 24, 32, 40, 48, 56, 64, 72, 80, 88, 96, 104, 112, 120, 128, 144, 160, 176, 192, 208, 224, 240, 256, 272, 288, 304, 320, 336, 352, 368, 384, 400, 416, 432, 448, 464, 480, 496, 512]\n      max_cudagraph_capture_size: 512\n    default_sampling_params:\n      temperature: 0.9\n      top_k: 50\n      max_tokens: 4096\n      min_tokens: 2\n      repetition_penalty: 1.05\n    subtalker_sampling_params:\n      do_sample: true\n      temperature: 0.9\n      top_k: 50\n      top_p: 1.0\n"
 },
